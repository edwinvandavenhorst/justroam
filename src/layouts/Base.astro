---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternatePath, pageUrl, type Lang } from '../i18n';

interface Props {
    lang: Lang;
    title: string;
    description: string;
    ogImage?: string;
    jsonLd?: object | object[];
}

const { lang, title, description, ogImage = '/images/hero.jpg', jsonLd } = Astro.props;
const site = Astro.site!;
const path = pageUrl(Astro.url.pathname);
const canonical = new URL(path, site).href;
const enUrl = new URL(alternatePath(path, 'en'), site).href;
const nlUrl = new URL(alternatePath(path, 'nl'), site).href;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {/* Bevestigt bij Gearhive dat deze site bij het account hoort (alleen staging, het testaccount op staging.gearhive.nl). */}
    {process.env.VERCEL_ENV !== 'production' && <meta name="gearhive-verificatie" content="bdb7c4f2-a220-4fb9-bc42-7b27f17ca4d3">}
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="alternate" hreflang="en" href={enUrl}>
    <link rel="alternate" hreflang="nl" href={nlUrl}>
    <link rel="alternate" hreflang="x-default" href={enUrl}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="JustRoam">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={new URL(ogImage, site).href}>
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_GB'}>
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" type="image/png" href="/favicon.png">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
    <a class="skip" href="#main">{lang === 'nl' ? 'Naar de inhoud' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
        <slot />
    </main>
    <Footer lang={lang} />
    <div class="mail-help" role="status" hidden data-text={lang === 'nl' ? 'Opende je mailprogramma niet? Mail ons op' : 'Did your mail app not open? Email us at'} data-copy={lang === 'nl' ? 'Kopieer adres' : 'Copy address'} data-copied={lang === 'nl' ? 'Gekopieerd' : 'Copied'}></div>
    <script>
        // A mailto link opens the default mail app with the email prepared.
        // Without a mail app set up (common with webmail such as Gmail) the
        // click does nothing at all, so if the page keeps focus we show the
        // address with a copy button.
        const box = document.querySelector<HTMLElement>('.mail-help');
        let timer = 0;
        document.addEventListener('click', (e) => {
            const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="mailto:"]');
            if (!a || !box) return;
            const address = decodeURIComponent(a.href.slice(7).split('?')[0]);
            clearTimeout(timer);
            timer = window.setTimeout(() => {
                if (!document.hasFocus() || document.visibilityState !== 'visible') return;
                box.innerHTML = '';
                const p = document.createElement('p');
                p.append(`${box.dataset.text} `, Object.assign(document.createElement('b'), { textContent: address }));
                const copy = Object.assign(document.createElement('button'), { type: 'button', textContent: box.dataset.copy || '' });
                copy.addEventListener('click', async () => {
                    try { await navigator.clipboard.writeText(address); copy.textContent = box.dataset.copied || ''; } catch { /* the address is on screen */ }
                });
                const close = Object.assign(document.createElement('button'), { type: 'button', className: 'mail-help-x', textContent: '×' });
                close.setAttribute('aria-label', 'Close');
                close.addEventListener('click', () => { box.hidden = true; });
                box.append(p, copy, close);
                box.hidden = false;
            }, 1500);
        });
        window.addEventListener('blur', () => clearTimeout(timer));
    </script>
</body>
</html>
