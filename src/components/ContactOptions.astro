---
// The ways to reach us, the same everywhere: WhatsApp, Instagram, email, phone.
// topic 'intake' fills WhatsApp and the email with the intake request template.
import { business } from '../data/site';
import type { Lang } from '../i18n';

interface Props { lang: Lang; topic?: 'intake' | 'general' }
const { lang, topic = 'general' } = Astro.props;
const nl = lang === 'nl';
const intake = topic === 'intake';

const template = nl
    ? 'Hoi Edwin, ik wil graag een intake plannen.\n\nAuto (merk, model, bouwjaar): \nHoe we reizen: \nWanneer moet de auto klaar zijn: \nWanneer kan ik bellen (dagen/tijden): '
    : "Hi Edwin, I'd like to plan an intake.\n\nVehicle (make, model, year): \nHow we travel: \nWhen should it be ready: \nWhen can I call (days/times): ";
const text = intake ? template : (nl ? 'Hoi Edwin, ik wil graag ' : "Hi Edwin, I'd like to ");
const subject = intake ? (nl ? 'Intake aanvragen' : 'Intake request') : (nl ? 'Vraag via justroam.nl' : 'Question via justroam.nl');
const mailto = `mailto:${business.email}?subject=${encodeURIComponent(subject)}${intake ? `&body=${encodeURIComponent(template)}` : ''}`;

const opts = [
    {
        href: `${business.whatsapp}?text=${encodeURIComponent(text)}`,
        title: intake ? (nl ? 'Vraag een intake aan' : 'Request an intake') : (nl ? 'App ons' : 'WhatsApp us'),
        sub: intake ? (nl ? 'Via WhatsApp' : 'Via WhatsApp') : (nl ? 'Meestal het snelst' : 'Usually the quickest'),
        icon: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm4.6 12.4c-.2.6-1.1 1.1-1.6 1.1-.4 0-.9.2-3-.6-2.5-1-4.1-3.6-4.2-3.8-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1.1.9 2 1.2 2.3 1.3.3.1.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.1.1.6-.1 1.2Z',
        fill: true,
        primary: true
    },
    {
        href: business.instagram,
        title: 'Instagram',
        sub: business.instagramHandle,
        icon: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Z M17.3 6.6h.01'
    },
    {
        href: mailto,
        title: nl ? 'Mail ons' : 'Email us',
        sub: business.email,
        icon: 'M3 6h18v12H3z M3 7l9 6 9-6'
    },
    {
        href: `tel:${business.phone}`,
        title: nl ? 'Bel ons' : 'Call us',
        sub: business.phoneDisplay,
        icon: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z',
        fill: true
    }
];
---
<div class="contact-opts">
    {opts.map((o) => (
        <a href={o.href} class={o.primary ? 'primary' : undefined} rel={o.href.startsWith('http') ? 'noopener' : undefined}>
            <i aria-hidden="true"><svg viewBox="0 0 24 24" class={o.fill ? 'fill' : undefined}><path d={o.icon} /></svg></i>
            <div><b>{o.title}</b><small>{o.sub}</small></div>
        </a>
    ))}
</div>
