---
import { ui, href, type Lang } from '../i18n';
import { business, links } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const nl = lang === 'nl';
---
<footer class="site-footer">
    <div class="wrap">
        <div class="grid">
            <div>
                <h4>JustRoam</h4>
                <p>{t.footerTagline}</p>
                <p>
                    <a href={`mailto:${business.email}`}>{business.email}</a><br>
                    <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a><br>
                    <a href={business.instagram} rel="noopener">Instagram</a>
                </p>
            </div>
            <div>
                <h4>{t.footerBuild}</h4>
                <ul>
                    <li><a href={href(lang, 'build.html')}>{t.packages}</a></li>
                    <li><a href={href(lang, 'build.html#plan')}>{t.plan}</a></li>
                    <li><a href={href(lang, 'blog_build.html')}>{t.buildStory}</a></li>
                </ul>
            </div>
            <div>
                <h4>{t.footerRent}</h4>
                <ul>
                    <li><a href={href(lang, 'rent.html')}>{nl ? 'Ranger huren' : 'Rent the Ranger'}</a></li>
                    <li><a href={href(lang, 'rent-gear.html')}>{nl ? 'Uitrusting huren' : 'Rent gear'}</a></li>
                    <li><a href={links.gearhive} rel="noopener">Gearhive</a></li>
                </ul>
            </div>
            <div>
                <h4>{t.footerMore}</h4>
                <ul>
                    <li><a href={href(lang, 'stories.html')}>{nl ? 'Verhalen' : 'Stories'}</a></li>
                    <li><a href={href(lang, 'faq.html')}>{t.faq}</a></li>
                    <li><a href={href(lang, 'contact.html')}>Contact</a></li>
                    <li><a href={href(lang, 'privacy.html')}>{t.privacy}</a></li>
                </ul>
            </div>
        </div>
        <div class="bottom">© JustRoam · KVK {business.kvk} · {business.locality}, {business.region}</div>
    </div>
</footer>
