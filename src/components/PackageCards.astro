---
// The build packages as cards: Basis, Ready to camp and the JustRoam module
// side by side, then "Add-ons and extras": the two add-ons and the list of
// extra options. Prices and days come from data/site.ts.
import ModuleInterest from './ModuleInterest.astro';
import { packages, euro, daysText } from '../data/site';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const nl = lang === 'nl';
const pk = Object.fromEntries(packages.map((p) => [p.key, p]));

type Item = { t: string; d: string; tag?: string };
const copy = nl ? {
    from: 'Vanaf',
    most: 'Meest compleet',
    plus: 'Alles uit Basis, plus:',
    explore: 'Ontdek deze ombouw',
    addonsT: 'Add-ons en extra\'s',
    addonsP: 'Voeg ze toe aan Basis of Ready to camp.',
    tags: {
        basis: 'Stroom onderweg, en klaar voor alles wat je later toevoegt.',
        camp: 'Alles om te koken, te slapen en weken te reizen.',
        offroad: 'Voor ruwe paden en afgelegen plekken.',
        lights: 'Zien en gezien worden, onderweg en op de camping.'
    },
    ask: { offroad: 'Vraag naar off-road', lights: 'Vraag naar verlichting' },
    module: {
        badge: 'In ontwikkeling',
        t: 'JustRoam-module',
        soon: 'Binnenkort',
        tag: 'Een complete kampeerunit die je onder de opbouw schuift die je al hebt.',
        items: [
            { t: 'Uitschuifkeuken', d: 'Koken achter je auto' },
            { t: 'Koelkast', d: 'Drinken koud, eten vers' },
            { t: 'Water', d: 'Tank, pomp en wasbak' },
            { t: 'Tweede accu', d: 'Stroom voor koelkast en je spullen, aan boord' },
            { t: 'Opbergruimte', d: 'Lades voor al je uitrusting' }
        ]
    },
    extrasT: 'Extra\'s',
    extrasP: 'Los toe te voegen aan elke ombouw.',
    extras: [['Opbouw, als je die nog niet hebt', 'vanaf €3.850'], ['Imperiaal, gemonteerd', 'vanaf €1.550'], ['Opvouwbaar zonnepaneel 200W', '€550'], ['Accudisplay in het bedieningspaneel', '€165'], ['Walstroomlader', '€180'], ['45L-koelkast in plaats van 35L', '+ €60'], ['Betere remmen voor', 'op aanvraag'], ['Tafel aan het plafond van de opbouw', '€510']],
    items: {
        basis: [
            { t: 'Tweede accu', d: 'Laadt op terwijl je rijdt' },
            { t: 'LED-verlichting', d: 'Achterin je auto' },
            { t: 'Alles opladen', d: 'USB en 12V-aansluitingen' },
            { t: 'Accumonitor', d: 'Zie je lading op je telefoon' },
            { t: 'Klaar om uit te breiden', d: 'Voorbedraad voor een koelkast, waterpomp en meer' },
            { t: 'Zonnepaneel', d: 'Laad je accu op als je stilstaat', tag: 'optioneel' }
        ],
        camp: [
            { t: 'Interieur op maat van je auto', d: 'Lades en opbergruimte, samen ontworpen' },
            { t: 'Keuken', d: 'Overal een echte maaltijd koken' },
            { t: 'Koelkast', d: 'Drinken koud, eten vers' },
            { t: 'Water', d: 'Tank, pomp en wasbak' },
            { t: 'Een plek om te slapen', d: 'Een daktent of een ingebouwd bed. Prijs in de intake', tag: 'maatwerk' },
            { t: 'Luifel', d: 'Je buitenruimte, met LED-verlichting. Prijs in de intake', tag: 'maatwerk' }
        ],
        offroad: [
            { t: 'Zwaardere vering', d: 'Draagt het extra gewicht en ruw terrein' },
            { t: 'Recovery', d: 'Lier, zandplaten en een snorkel' },
            { t: 'Bescherming', d: 'Skid plates en rock sliders' }
        ],
        lights: [
            { t: 'Verlichting voor', d: 'Ingebouwd in de grille, voor rijden in het donker' },
            { t: 'Lichtbalk achter', d: 'Licht op je kampeerplek en achter de auto' },
            { t: 'Schakelaars op het dashboard', d: 'Gemonteerd en aangesloten' }
        ]
    } as Record<string, Item[]>
} : {
    from: 'From',
    most: 'Most complete',
    plus: 'Everything in Basis, plus:',
    explore: 'Explore this build',
    addonsT: 'Add-ons and extras',
    addonsP: 'Add them to Basis or Ready to camp.',
    tags: {
        basis: 'Power on the road, and ready for whatever you add later.',
        camp: 'Everything you need to cook, sleep and travel for weeks.',
        offroad: 'For rough tracks and remote places.',
        lights: 'See and be seen, on the road and at camp.'
    },
    ask: { offroad: 'Ask about off-road', lights: 'Ask about lighting' },
    module: {
        badge: 'In development',
        t: 'JustRoam module',
        soon: 'Coming soon',
        tag: 'A complete camping unit that slides in under the canopy you already have.',
        items: [
            { t: 'Slide-out kitchen', d: 'Cook at the back of your vehicle' },
            { t: 'Fridge', d: 'Drinks cold, food fresh' },
            { t: 'Water', d: 'Tank, pump and basin' },
            { t: 'Second battery', d: 'Power for the fridge and your devices, on board' },
            { t: 'Storage', d: 'Drawers for all your gear' }
        ]
    },
    extrasT: 'Extras',
    extrasP: 'Add to any build.',
    extras: [['Canopy, if you do not have one yet', 'from €3,850'], ['Roof rack, fitted', 'from €1,550'], ['Folding solar panel 200W', '€550'], ['Battery display in the control panel', '€165'], ['Shore power charger', '€180'], ['45L fridge instead of 35L', '+ €60'], ['Front brake upgrade', 'on request'], ['Table on the canopy ceiling', '€510']],
    items: {
        basis: [
            { t: 'Second battery', d: 'Charges while you drive' },
            { t: 'LED lighting', d: 'In the back of your vehicle' },
            { t: 'Charge all devices', d: 'USB ports and 12V outlets' },
            { t: 'Battery monitor', d: 'See your charge on your phone' },
            { t: 'Ready to expand', d: 'Pre-wired for a fridge, water pump and more' },
            { t: 'Solar panel', d: 'Charge your battery while parked', tag: 'optional' }
        ],
        camp: [
            { t: 'Interior made for your vehicle', d: 'Drawers and storage, designed together' },
            { t: 'Kitchen', d: 'Cook a proper meal anywhere' },
            { t: 'Fridge', d: 'Drinks cold, food fresh' },
            { t: 'Water', d: 'Tank, pump and basin' },
            { t: 'A place to sleep', d: 'A rooftop tent, or a bed built in. Priced in the intake', tag: 'custom' },
            { t: 'Awning', d: 'Your outdoor living space, with LED lights. Priced in the intake', tag: 'custom' }
        ],
        offroad: [
            { t: 'Upgraded suspension', d: 'Handles the extra weight and rough terrain' },
            { t: 'Recovery gear', d: 'Winch, recovery boards and a snorkel' },
            { t: 'Protection', d: 'Skid plates and rock sliders' }
        ],
        lights: [
            { t: 'Front lights', d: 'Built into the grille, for night driving' },
            { t: 'Rear light bar', d: 'Light up your camp and the back of the vehicle' },
            { t: 'Switches on the dash', d: 'Fitted and wired' }
        ]
    } as Record<string, Item[]>
};
const list = (key: string) => copy.items[key];
const plan = '#plan';
---
<div class="pk-grid">
    {['basis', 'camp'].map((key) => (
        <article class={key === 'camp' ? 'pk main' : 'pk'} id={'pk-' + key}>
            {key === 'camp' && <span class="badge">{copy.most}</span>}
            <h3>{pk[key].name[lang]}</h3>
            <div class="meta">{copy.from} {euro(pk[key].from, lang)}<span>{daysText(pk[key], lang)}</span></div>
            <p class="tag">{copy.tags[key as 'basis']}</p>
            {key === 'camp' && <div class="plus">{copy.plus}</div>}
            <ul>{list(key).map((i) => <li><b>{i.t}{i.tag && <em>{i.tag}</em>}</b>{i.d}</li>)}</ul>
            <a class={key === 'camp' ? 'btn cta' : 'btn light cta'} href={plan}>{copy.explore} <span class="ar" aria-hidden="true">→</span></a>
        </article>
    ))}
    <article class="pk upcoming" id="pk-module">
        <span class="badge">{copy.module.badge}</span>
        <h3>{copy.module.t}</h3>
        <div class="meta">{copy.module.soon}</div>
        <p class="tag">{copy.module.tag}</p>
        <ul>{copy.module.items.map((i) => <li><b>{i.t}</b>{i.d}</li>)}</ul>
        <ModuleInterest lang={lang} />
    </article>
</div>

<div class="addon-head" id="addons">
    <h3>{copy.addonsT}</h3>
    <p>{copy.addonsP}</p>
</div>
<div class="addon-row">
    {['offroad', 'lights'].map((key) => (
        <article class="pk addon" id={'pk-' + key}>
            <h3>{pk[key].name[lang]}</h3>
            <div class="meta">{copy.from} {euro(pk[key].from, lang)}<span>{daysText(pk[key], lang)}</span></div>
            <p class="tag">{copy.tags[key as 'offroad']}</p>
            <ul>{list(key).map((i) => <li><b>{i.t}</b>{i.d}</li>)}</ul>
            <a class="btn light cta" href={plan}>{copy.ask[key as 'offroad']} <span class="ar" aria-hidden="true">→</span></a>
        </article>
    ))}
    <article class="pk extras" id="pk-extras">
        <h3>{copy.extrasT}</h3>
        <p class="tag">{copy.extrasP}</p>
        <ul>{copy.extras.map(([a, b]) => <li><span>{a}</span><span>{b}</span></li>)}</ul>
    </article>
</div>
