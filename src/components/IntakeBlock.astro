---
// "Plan your intake": the free 30-minute call that starts every build.
// Visitors book it in Edwin's calendar (Cal.com), or request it via
// WhatsApp or email with a template. Used on the contact page and the
// build page.
import ContactOptions from './ContactOptions.astro';
import { href, type Lang } from '../i18n';

interface Props { lang: Lang; packagesLink?: boolean }
const { lang, packagesLink = false } = Astro.props;
const nl = lang === 'nl';

const copy = nl ? {
    kicker: 'Plan je ombouw',
    title: 'Begin met een gesprek',
    intro: 'Net begonnen met overlanden, of al jaren onderweg? Heb je al een auto, of weet je nog niet wat bij je past? Neem contact op, dan werken we samen toe naar de auto en de ombouw die bij jou passen: gemaakt voor jouw dromen en jouw soort avontuur.',
    packages: 'Bekijk eerst de pakketten'
} : {
    kicker: 'Plan your build',
    title: 'Start with a conversation',
    intro: 'New to overlanding, or years on the road? Already have a vehicle, or not sure yet what suits you? Get in touch, and together we work towards the vehicle and build that fit you: made for your dreams and your kind of adventure.',
    packages: 'See the packages first'
};

// Shown when hovering "Book your intake" (on touch screens: a fold-out below the options).
const calInfo = nl ? {
    more: 'Wat gebeurt er in de intake?',
    intro: 'Een gratis en vrijblijvend gesprek van 30 minuten, telefonisch of via video. We lopen samen door:',
    list: ['Je auto: merk, model en bouwjaar', 'Hoe je reist: weekenden of weken, met wie', 'Wat je wilt, en waar je over twijfelt', 'Je budget, en wanneer de auto klaar moet zijn'],
    after: 'Daarna weet je wat er kan, wat het ongeveer kost en hoe lang het duurt.'
} : {
    more: 'What happens in the intake?',
    intro: 'A free, no-obligation 30-minute call, by phone or video. Together we go through:',
    list: ['Your vehicle: make, model and year', 'How you travel: weekends or weeks, with whom', 'What you want, and what you are unsure about', 'Your budget, and when the vehicle should be ready'],
    after: 'Afterwards you know what is possible, roughly what it costs and how long it takes.'
};
---
<div class="plan">
    <div>
        <span class="kicker">{copy.kicker}</span>
        <h2>{copy.title}</h2>
        <p class="lead" style="margin-top:14px">{copy.intro}</p>
        {packagesLink && <p style="margin-top:16px"><a class="link" href={href(lang, 'build.html#packages')}>{copy.packages}</a></p>}
    </div>
    <ContactOptions lang={lang} topic="intake" calInfo={calInfo} />
</div>
