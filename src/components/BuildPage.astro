---
import { plain } from '../data/faq';
// The build page: one photo and one promise, the packages and add-ons,
// options and warranty, the route from first call to first trip, and the
// intake. Approved as mockup K (Nov 2026).
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import PackageCards from './PackageCards.astro';
import IntakeBlock from './IntakeBlock.astro';
import type { Lang } from '../i18n';
import { business, links, packages, euro, daysText } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const nl = lang === 'nl';

const copy = {
    en: {
        title: 'Overland Builds for Your 4x4 in NL, DE & BE | JustRoam',
        description: 'Two build packages and two add-ons for your own pickup truck or 4x4: power, interior, kitchen, water, off-road and lighting. From €6,000 incl. VAT, built in Voorburg.',
        h1: 'Turn your 4x4 into an overland-ready adventure machine',
        lede: 'For your own pickup or 4x4. We build it for you, or we build it together.',
        heroCta: 'View the packages',
        heroAlt: 'Our Ranger with rooftop tent and awning in a forest',
        pkKicker: 'Build packages',
        pkT: 'Start with power, go all the way to camping',
        pkP: 'Two packages, two add-ons and a module on the way, as a starting point. We tailor the details of every package to your vehicle and the way you travel, whether it is a pickup like a Ranger or Hilux, or a 4x4 like a Land Cruiser, Defender or Jimny.',
        fits: 'All prices include VAT, parts and labour, excluding the vehicle. Workshop days are working days on your build; we agree the dates together.',
        measure: ['Every build is custom made.', 'In the intake we go through what you need, what you can leave out, and which parts you might add on their own.'],
        routeKicker: 'Your build, step by step',
        routeT: 'From first call to first trip.',
        route: [['Intake', 'A free 30-minute call about your vehicle, how you travel and your budget.'], ['Design together', 'We design your interior around how you travel, and agree on price and planning.'], ['Build', 'We build it for you, or you build alongside us on agreed days. We always do the electrics and the gas.'], ['Handover', 'We walk you through everything, and off you go.']],
        routeCta: 'Plan your intake',
        vehicle: ['JustRoam does not supply vehicles.', 'New to overlanding, or could you use some help? We can put together a short list of vehicles that suit your build. This service costs a one-time fee of €180, credited against your build if you decide to have us build your vehicle.', 'Book this service here'],
        adviceUrl: links.cal.advice[lang],
        map: { label: 'Sketch of the route from your idea to your first trip', idea: 'Your idea', intake: 'Intake', design: 'Design', build: 'Build in Voorburg', handover: 'Handover', trip: 'First trip', note: 'Sketch, not to scale.' },
        faqT: 'Questions about a build',
        chaptersLabel: 'On this page',
        chapters: [['packages', 'Packages'], ['addons', 'Add-ons and extras'], ['steps', 'How it works'], ['plan', 'Intake'], ['faq', 'FAQ']],
    },
    nl: {
        title: 'Overland-ombouw voor je 4x4 in NL, DE en BE | JustRoam',
        description: 'Twee ombouwpakketten en twee add-ons voor je eigen pickup of 4x4: stroom, interieur, keuken, water, off-road en verlichting. Vanaf €6.000 incl. btw, gebouwd in Voorburg.',
        h1: 'Maak van je 4x4 een overland-auto, klaar voor avontuur',
        lede: 'Voor je eigen pickup of 4x4. Wij bouwen hem voor je, of we bouwen hem samen.',
        heroCta: 'Bekijk de pakketten',
        heroAlt: 'Onze Ranger met daktent en luifel in het bos',
        pkKicker: 'Ombouwpakketten',
        pkT: 'Begin met stroom, ga door tot kamperen',
        pkP: 'Twee pakketten, twee add-ons en een module in ontwikkeling, als vertrekpunt. De details stemmen we af op je auto en hoe je reist, of het nu een pickup als een Ranger of Hilux is, of een 4x4 als een Land Cruiser, Defender of Jimny.',
        fits: 'Alle prijzen zijn inclusief btw, onderdelen en arbeid, exclusief de auto. Werkdagen zijn dagen waarop we aan jouw auto werken; de data spreken we samen af.',
        measure: ['Elke ombouw is maatwerk.', 'In de intake bespreken we wat je nodig hebt, wat je kunt weglaten en welke onderdelen je los kunt toevoegen.'],
        routeKicker: 'Je ombouw, stap voor stap',
        routeT: 'Van eerste gesprek tot eerste reis.',
        route: [['Intake', 'Een gratis gesprek van 30 minuten over je auto, hoe je reist en je budget.'], ['Samen ontwerpen', 'We ontwerpen je interieur rond hoe je reist, en spreken prijs en planning af.'], ['Bouwen', 'Wij bouwen hem voor je, of je bouwt op afgesproken dagen mee. De elektra en het gas doen we altijd zelf.'], ['Oplevering', 'We lopen alles samen met je door, en dan kun je op pad.']],
        routeCta: 'Plan je intake',
        vehicle: ['JustRoam levert geen auto\'s.', 'Nieuw in overlanden, of kun je wat hulp gebruiken? We stellen een korte lijst samen met auto\'s die passen bij je ombouw. Deze service kost eenmalig €180, en dat verrekenen we met je ombouw als je die door ons laat bouwen.', 'Boek deze service hier'],
        adviceUrl: links.cal.advice[lang],
        map: { label: 'Schets van de route van je idee naar je eerste reis', idea: 'Je idee', intake: 'Intake', design: 'Ontwerp', build: 'Bouwen in Voorburg', handover: 'Oplevering', trip: 'Eerste reis', note: 'Schets, niet op schaal.' },
        faqT: 'Vragen over ombouw',
        chaptersLabel: 'Op deze pagina',
        chapters: [['packages', 'Pakketten'], ['addons', 'Add-ons en extra\'s'], ['steps', 'Zo werkt het'], ['plan', 'Intake'], ['faq', 'FAQ']],
    }
}[lang];

const pk = Object.fromEntries(packages.map((p) => [p.key, p]));
const price = (k: string) => euro(pk[k].from, lang);

const faq = nl ? [
    { q: 'Wat is het verschil tussen de pakketten?', a: `Basis (vanaf ${price('basis')}) geeft je stroom onderweg: een tweede accu die laadt tijdens het rijden, LED-verlichting, USB en 12V, een accumonitor en voorbedrading voor later. Ready to camp (vanaf ${price('camp')}, Basis inbegrepen) voegt een interieur op maat, keuken, koelkast en water toe. Daarbovenop kun je Full off-road (vanaf ${price('offroad')}) en buitenverlichting (vanaf ${price('lights')}) toevoegen.` },
    { q: 'Hoe lang duurt een ombouw?', a: `We rekenen in werkdagen: ${daysText(pk.basis, lang)} voor Basis, ${daysText(pk.camp, lang)} voor Ready to camp, plus ${daysText(pk.offroad, lang)} voor off-road en ${daysText(pk.lights, lang)} voor de verlichting. De data spreken we samen af in de intake.` },
    { q: 'Wat zit er niet in de prijs?', a: 'De auto zelf, en een daktent en luifel: die zijn maatwerk en prijzen we in de intake. Heb je nog geen opbouw, dan staat die bij de extra\'s.' },
    { q: 'Hoe komt de offerte tot stand?', a: 'Na de intake maken we op basis van je wensen een begroting, met de prijzen die op dat moment gelden. Omdat elke auto anders is, kan de prijs per auto verschillen. Daarom duurt het een paar dagen voordat je de offerte krijgt. Onderdelen factureren we achteraf op wat we echt gebruikt hebben; wijkt dat meer dan 10% af, dan nemen we eerst contact met je op.' },
    { q: 'Is er garantie?', a: 'Ja. Gaat er iets mis door hoe wij gebouwd hebben, of door een onderdeel dat wij geleverd hebben, dan maken we het kosteloos. Dat geldt tot 12 maanden na de oplevering. Onderdelen hebben daarnaast hun eigen fabrieksgarantie, en die claim regelen wij voor je. Niet gedekt: schade door gebruik waar de ombouw niet voor bedoeld is, overbelasting of ongelukken, wijzigingen of reparaties door iemand anders, en normale slijtage.' },
    { q: 'Lever ik mijn eigen auto aan?', a: 'Ja. JustRoam levert geen auto\'s; we bouwen een auto om die van jou is, in Nederland, Duitsland en België. Nieuw in overlanden, of kun je wat hulp gebruiken? Dan stellen we een korte lijst samen met auto\'s die passen bij je ombouw. Dat kost eenmalig €180, en dat verrekenen we met je ombouw als je die door ons laat bouwen. Lees de <a href="/nl/vehicle-advice-terms.html">voorwaarden voor het advies</a>.' },
    { q: 'In welke auto\'s bouwen jullie?', a: 'In pickups zoals de Ford Ranger, Toyota Hilux, Isuzu D-Max, Volkswagen Amarok, Nissan Navara, Mitsubishi L200, Jeep Gladiator, Ineos Quartermaster en RAM 1500, en in 4x4\'s (4WD) zoals de Toyota Land Cruiser, Land Rover Defender, Land Rover Discovery, Ineos Grenadier, Mitsubishi Pajero, Nissan Patrol, Jeep Wrangler en Suzuki Jimny. Elke auto is anders, dus de details stemmen we in de intake af op jouw auto. Staat de jouwe er niet bij? Vraag het gerust.' },
    { q: 'Moet ik een aanbetaling doen?', a: 'Ja. Bij de opdracht betaal je 30%. Daarmee bestellen we de onderdelen en leggen we je bouwdata vast. De rest betaal je bij de oplevering. Bij grotere ombouwen, zoals Ready to camp met off-road, werken we met drie termijnen: 30% bij de opdracht, 40% bij de start van de bouw en 30% bij de oplevering. Tot we onderdelen bestellen, krijg je de aanbetaling terug als je afziet van de ombouw.' },
    { q: 'Kan ik een ombouw eerst uitproberen?', a: 'Ja, door onze eigen Ranger te huren. Die heeft een opbouw, keuken, water, twee daktenten en recovery-uitrusting, dus na een weekend weet je wat je in je eigen auto wilt.' }
] : [
    { q: 'What is the difference between the packages?', a: `Basis (from ${price('basis')}) gives you power on the road: a second battery that charges while you drive, LED lighting, USB and 12V, a battery monitor and wiring ready for later. Ready to camp (from ${price('camp')}, Basis included) adds an interior made for your vehicle, a kitchen, a fridge and water. On top of either you can add Full off-road (from ${price('offroad')}) and outdoor lighting (from ${price('lights')}).` },
    { q: 'How long does a build take?', a: `We count in workshop days: ${daysText(pk.basis, lang)} for Basis, ${daysText(pk.camp, lang)} for Ready to camp, plus ${daysText(pk.offroad, lang)} for off-road and ${daysText(pk.lights, lang)} for lighting. We agree the dates together in the intake.` },
    { q: 'What is not in the price?', a: 'The vehicle itself, and a rooftop tent and awning: those are custom made and priced in the intake. If you do not have a canopy yet, you will find it under the extras.' },
    { q: 'How do you put the quote together?', a: 'After the intake we make a budget based on your wishes, using the prices that apply at that moment. Every vehicle is different, so the price can differ per vehicle. That is why it takes a few days before we send you the quote. Parts are invoiced afterwards on what we actually used; if that differs by more than 10%, we contact you first.' },
    { q: 'Is there a warranty?', a: 'Yes. If something fails because of how we built it, or because of a part we supplied, we fix it at no cost. That applies for 12 months after delivery. Parts also carry their own manufacturer warranty, and we handle that claim for you. Not covered: damage from use the build is not meant for, overloading or accidents, changes or repairs by someone else, and normal wear.' },
    { q: 'Do I supply my own vehicle?', a: 'Yes. JustRoam does not supply vehicles; we convert a vehicle you own, in the Netherlands, Germany and Belgium. New to overlanding, or could you use some help? We can put together a short list of vehicles that suit your build. That costs a one-time fee of €180, credited against your build if you decide to have us build your vehicle. Read the <a href="/vehicle-advice-terms.html">terms for the advice</a>.' },
    { q: 'Which vehicles do you build?', a: 'Pickup trucks like the Ford Ranger, Toyota Hilux, Isuzu D-Max, Volkswagen Amarok, Nissan Navara, Mitsubishi L200, Jeep Gladiator, Ineos Quartermaster and RAM 1500, and 4x4s (4WD) like the Toyota Land Cruiser, Land Rover Defender, Land Rover Discovery, Ineos Grenadier, Mitsubishi Pajero, Nissan Patrol, Jeep Wrangler and Suzuki Jimny. Every vehicle is different, so we tailor the details to yours in the intake. Is yours not on the list? Just ask.' },
    { q: 'Do I pay a deposit?', a: 'Yes. You pay 30% when you place the order. We use it to order the parts and to fix your build dates. You pay the rest at handover. For larger builds, such as Ready to camp with off-road, we work in three stages: 30% at order, 40% when the build starts and 30% at handover. Until we order parts, you get your deposit back if you decide not to go ahead.' },
    { q: 'Can I try a build before I commit?', a: 'Yes, by renting our own Ranger. It has a canopy, kitchen, water, two rooftop tents and recovery gear, so a weekend away shows you what you want in your own vehicle.' }
];

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: nl ? 'Overland-ombouw voor pickups en 4x4\'s' : 'Overland builds for pickups and 4x4s',
        serviceType: nl ? 'Voertuigombouw' : 'Vehicle conversion',
        provider: { '@type': 'LocalBusiness', name: business.name, url: business.url, telephone: business.phone, address: { '@type': 'PostalAddress', addressLocality: business.locality, addressCountry: business.country } },
        areaServed: ['Netherlands', 'Germany', 'Belgium'].map((name) => ({ '@type': 'Country', name })),
        hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: nl ? 'Ombouwpakketten' : 'Build packages',
            itemListElement: packages.map((p) => ({
                '@type': 'Offer',
                itemOffered: { '@type': 'Service', name: p.name[lang], description: daysText(p, lang) },
                priceSpecification: { '@type': 'PriceSpecification', minPrice: p.from, priceCurrency: 'EUR', valueAddedTaxIncluded: true }
            }))
        }
    },
    { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })) }
];
---
<Base lang={lang} title={copy.title} description={copy.description} ogImage="/images/build/IMG_50.jpeg" jsonLd={jsonLd}>
    <section class="build-hero">
        <Photo class="cover" src="/images/build/IMG_50.jpeg" width={1960} height={1103} alt={copy.heroAlt} sizes="100vw" eager />
        <div class="wrap">
            <h1>{copy.h1}</h1>
            <p>{copy.lede}</p>
            <a class="btn sand" href="#packages">{copy.heroCta} <span class="ar" aria-hidden="true">→</span></a>
        </div>
    </section>

    <nav class="chapters" aria-label={copy.chaptersLabel}>
        <div class="wrap">{copy.chapters.map(([id, label]) => <a href={'#' + id}>{label}</a>)}</div>
    </nav>

    <section class="wrap section" id="packages">
        <div class="build-head">
            <span class="kicker">{copy.pkKicker}</span>
            <h2>{copy.pkT}</h2>
            <p>{copy.pkP}</p>
        </div>
        <PackageCards lang={lang} />
        <p class="fits">{copy.fits}</p>
        <p class="fits"><b>{copy.measure[0]}</b> {copy.measure[1]}</p>
    </section>

    <section class="route-poster" id="steps">
        <div class="wrap">
            <div>
                <span class="kicker">{copy.routeKicker}</span>
                <h2>{copy.routeT}</h2>
                <ol>{copy.route.map(([t, d], i) => <li><b>{i + 1}</b><div><strong>{t}</strong>{d}</div></li>)}</ol>
                <p class="route-vehicle"><b>{copy.vehicle[0]}</b> {copy.vehicle[1]} <a href={copy.adviceUrl} target="_blank" rel="noopener">{copy.vehicle[2]}</a></p>
                <a class="btn sand" href={links.cal.build[lang]} target="_blank" rel="noopener">{copy.routeCta} <span class="ar" aria-hidden="true">→</span></a>
            </div>
            <div class="map">
                <svg viewBox="0 0 600 420" role="img" aria-label={copy.map.label}>
                    <rect width="600" height="420" fill="#2f1503" />
                    <g fill="none" stroke="#5a3418" stroke-width="1">
                        <path d="M0 80 Q150 60 300 90 T600 70" /><path d="M0 200 Q160 180 320 210 T600 190" /><path d="M0 320 Q180 300 330 330 T600 310" />
                        <path d="M120 0 Q100 140 140 260 T120 420" /><path d="M300 0 Q330 160 290 280 T320 420" /><path d="M470 0 Q450 120 490 250 T460 420" />
                    </g>
                    <path d="M80 80 C 150 80, 170 150, 220 160 S 300 120, 340 170 S 330 260, 400 280 S 500 300, 520 350" fill="none" stroke="#ecd3a9" stroke-width="3" stroke-dasharray="8 7" stroke-linecap="round" />
                    <g font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="16" fill="#2b1d12" text-anchor="middle">
                        <circle cx="80" cy="80" r="14" fill="#ff6b35" /><text x="80" y="86">!</text>
                        <circle cx="220" cy="160" r="14" fill="#d4a76a" /><text x="220" y="166">1</text>
                        <circle cx="340" cy="170" r="14" fill="#d4a76a" /><text x="340" y="176">2</text>
                        <circle cx="400" cy="280" r="14" fill="#d4a76a" /><text x="400" y="286">3</text>
                        <circle cx="520" cy="350" r="14" fill="#d4a76a" /><text x="520" y="356">4</text>
                    </g>
                    <g font-family="Barlow, sans-serif" font-size="14" fill="#ecd3a9">
                        <text x="100" y="66">{copy.map.idea}</text>
                        <text x="200" y="196">{copy.map.intake}</text>
                        <text x="360" y="160">{copy.map.design}</text>
                        <text x="420" y="276">{copy.map.build}</text>
                        <text x="520" y="392" text-anchor="middle">{copy.map.handover}</text>
                        <text x="552" y="298" text-anchor="middle">{copy.map.trip}</text>
                    </g>
                    <path d="M540 340 v-30 h18 l-5 6 l5 6 h-18" fill="none" stroke="#ecd3a9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <text x="40" y="404" font-family="Barlow, sans-serif" font-size="12" fill="#b49a7a">{copy.map.note}</text>
                </svg>
            </div>
        </div>
    </section>

    <section class="wrap section" id="plan">
        <IntakeBlock lang={lang} />
    </section>

    <section class="wrap" id="faq" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <h2 style="margin-bottom:22px">{copy.faqT}</h2>
        <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}</div>
    </section>
</Base>

<script>
    // Mark the chapter you are reading in the bar: the last one whose top has
    // passed the upper third of the screen. On small screens, keep it in view.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.chapters a')];
    const targets = links.map((a) => document.getElementById(a.hash.slice(1)));
    let current = -1;
    const update = () => {
        const line = window.innerHeight * 0.35;
        let i = -1;
        targets.forEach((el, n) => { if (el && el.getBoundingClientRect().top <= line) i = n; });
        if (i === current) return;
        current = i;
        links.forEach((a, n) => a.classList.toggle('on', n === i));
        const on = links[i];
        if (on && on.parentElement) on.parentElement.scrollTo({ left: on.offsetLeft - 16, behavior: 'smooth' });
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
</script>
