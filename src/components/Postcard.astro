---
// A vintage "Greetings from" photo postcard for the top of a trip story
// (blog mockup D): one photo from the trip, the greeting written on it, the
// place name in slab letters, and a stamp and postmark in the style of the
// country. One SVG, so it scales as a whole on every screen.
import { getImage } from 'astro:assets';
import '@fontsource/yellowtail/400.css';
import '@fontsource/alfa-slab-one/400.css';

export interface PostcardData {
    greeting: string;          // "Greetings from"
    word: string;              // "BOSNIA"
    photo: { src: string; w: number; h: number };
    colors: { word: string; outline: string; stampBg: string; stampAccent: string; stampStars: boolean };
    stamp: { country: string; value: string };
    postmark: { place: string; date: string };
    label: string;             // accessible description
}

interface Props { card: PostcardData }
const { card } = Astro.props;
const c = card.colors;
const img = await getImage({ src: card.photo.src, width: 1200, height: Math.round((1200 * card.photo.h) / card.photo.w), format: 'webp' });
const uid = card.word.toLowerCase().replace(/[^a-z]/g, '');
const star = 'M0 -10 L2.9 -3.1 L9.5 -3.1 L4.2 1.2 L6.2 8.1 L0 4 L-6.2 8.1 L-4.2 1.2 L-9.5 -3.1 L-2.9 -3.1 Z';
// Long names get smaller letters so the word stays on the card.
const wordSize = Math.min(120, Math.round(820 / (card.word.length * 0.78)));
---
<figure class="postcard-hero">
    <svg viewBox="0 0 1000 660" role="img" aria-label={card.label} xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id={`shade-${uid}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0.45" stop-color="#000" stop-opacity="0" />
                <stop offset="1" stop-color="#000" stop-opacity="0.55" />
            </linearGradient>
        </defs>
        <rect width="1000" height="660" rx="8" fill="#fff8e8" />
        <image href={img.src} x="26" y="26" width="948" height="608" preserveAspectRatio="xMidYMid slice" />
        <rect x="26" y="26" width="948" height="608" fill={`url(#shade-${uid})`} />

        <text x="70" y="500" class="pc-script" font-size="78" fill="#fff8e8" transform="rotate(-6 70 500)">{card.greeting}</text>
        <text x="64" y="598" class="pc-word" font-size={wordSize} letter-spacing="6" fill={c.word} stroke={c.outline} stroke-width="5" paint-order="stroke">{card.word}</text>

        <g transform="translate(840 50) rotate(4)">
            <rect width="120" height="146" fill="#fff8e8" />
            <rect width="120" height="146" fill="none" stroke="#f7eedb" stroke-width="9" stroke-dasharray="0.1 11" stroke-linecap="round" />
            <rect x="10" y="10" width="100" height="126" fill={c.stampBg} />
            <path d="M32 10 L96 10 L96 98 Z" fill={c.stampAccent} />
            {c.stampStars && [0, 1, 2, 3, 4].map((k) => <path transform={`translate(${28 + k * 13} ${20 + k * 16}) scale(0.5)`} d={star} fill="#fff8e8" />)}
            <text x="16" y="120" class="pc-stamp" font-size="10.5" fill="#fff8e8">{card.stamp.country}</text>
            <text x="104" y="131" text-anchor="end" class="pc-stamp" font-size="16" fill="#fff8e8">{card.stamp.value}</text>
        </g>

        <g transform="translate(810 196) rotate(-12)" fill="none" stroke="#2c2a4a" stroke-opacity="0.7" stroke-width="2.5">
            <circle r="50" />
            <circle r="36" />
            <path id={`pm-${uid}`} d="M-43 0 A43 43 0 1 1 43 0" stroke="none" />
            <text class="pc-stamp" font-size="12.5" fill="#2c2a4a" fill-opacity="0.8" stroke="none"><textPath href={`#pm-${uid}`} startOffset="50%" text-anchor="middle">{card.postmark.place}</textPath></text>
            <text y="5" text-anchor="middle" class="pc-stamp" font-size="12.5" fill="#2c2a4a" fill-opacity="0.8" stroke="none">{card.postmark.date}</text>
            <path d="M56 -18 q 18 -10 36 0 t 36 0 M56 0 q 18 -10 36 0 t 36 0 M56 18 q 18 -10 36 0 t 36 0" />
        </g>
    </svg>
</figure>
