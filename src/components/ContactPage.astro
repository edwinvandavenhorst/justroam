---
// Contact: mostly for builds, since renting goes through Goboony and gear
// through Gearhive. No form: WhatsApp, phone, email and Instagram.
import Base from '../layouts/Base.astro';
import ContactOptions from './ContactOptions.astro';
import { href, type Lang } from '../i18n';
import { business, links } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const nl = lang === 'nl';

const copy = nl ? {
    title: 'Contact | Overland-ombouw en verhuur in Voorburg | JustRoam',
    description: 'Neem contact op met JustRoam in Voorburg over een overland-ombouw, het huren van onze Ford Ranger of een dakkoffer en fietsendrager. App, bel of mail ons.',
    kicker: 'Contact',
    h1: 'Plan je ombouw, of stel je vraag',
    lead: 'App, bel of mail ons. We reageren meestal binnen een dag.',
    planT: 'Een ombouw plannen?',
    planP: 'Stuur ons deze punten mee, dan komen we terug met advies en een offerte:',
    planList: ['Merk, model en bouwjaar van je auto', 'Hoe je reist: weekenden, weken, met wie', 'Welk pakket je aanspreekt, of waar je over twijfelt', 'Wanneer je de auto klaar wilt hebben'],
    planLink: 'Bekijk eerst de pakketten',
    rentT: 'De Ranger huren?', rentP: 'Data, prijzen, boeken, betalen en de borg lopen via Goboony.', rentCta: 'Bekijk data en prijzen',
    gearT: 'Uitrusting huren?', gearP: 'De dakkoffer en fietsendrager boek je direct via Gearhive.', gearCta: 'Naar uitrusting huren',
    faqT: 'Eerst zelf zoeken?', faqP: 'De meeste vragen over huren en ombouw staan in de FAQ.', faqCta: 'Naar de FAQ',
    detailsT: 'Gegevens'
} : {
    title: 'Contact | Overland Builds & Rental in Voorburg | JustRoam',
    description: 'Get in touch with JustRoam in Voorburg about an overland build, renting our Ford Ranger, or a roof box and bike carrier. WhatsApp, call or email us.',
    kicker: 'Contact',
    h1: 'Plan your build, or just ask',
    lead: 'WhatsApp, call or email us. We usually reply within a day.',
    planT: 'Planning a build?',
    planP: 'Send us these points and we will come back with advice and a quote:',
    planList: ['Make, model and year of your vehicle', 'How you travel: weekends, weeks, with whom', 'Which package appeals to you, or what you are unsure about', 'When you would like the vehicle to be ready'],
    planLink: 'See the packages first',
    rentT: 'Renting the Ranger?', rentP: 'Dates, prices, booking, payment and the deposit all go through Goboony.', rentCta: 'See dates and prices',
    gearT: 'Renting gear?', gearP: 'Book the roof box and bike carrier directly through Gearhive.', gearCta: 'Go to rent gear',
    faqT: 'Rather look it up?', faqP: 'Most questions about renting and builds are answered in the FAQ.', faqCta: 'Go to the FAQ',
    detailsT: 'Details'
};

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: copy.title,
    mainEntity: {
        '@type': 'LocalBusiness',
        name: business.name,
        url: business.url,
        email: business.email,
        telephone: business.phone,
        image: 'https://justroam.nl/images/Logo_JustRoam.svg',
        address: { '@type': 'PostalAddress', addressLocality: business.locality, addressRegion: business.region, addressCountry: business.country },
        areaServed: ['Netherlands', 'Germany', 'Belgium'].map((name) => ({ '@type': 'Country', name })),
        sameAs: [business.instagram, links.goboony, links.gearhive],
        contactPoint: {
            '@type': 'ContactPoint',
            contactType: 'customer service',
            telephone: business.phone,
            email: business.email,
            availableLanguage: ['English', 'Dutch']
        }
    }
};
---
<Base lang={lang} title={copy.title} description={copy.description} jsonLd={jsonLd}>
    <section class="wrap contact-page">
        <div class="contact-head">
            <span class="kicker">{copy.kicker}</span>
            <h1>{copy.h1}</h1>
            <p class="lead">{copy.lead}</p>
        </div>

        <div class="plan">
            <div>
                <h2>{copy.planT}</h2>
                <p class="lead" style="margin-top:14px">{copy.planP}</p>
                <ol>{copy.planList.map((l) => <li>{l}</li>)}</ol>
                <p style="margin-top:18px"><a class="link" href={href(lang, 'build.html#packages')}>{copy.planLink}</a></p>
            </div>
            <ContactOptions lang={lang} topic="build" />
        </div>

        <div class="contact-routes">
            <div>
                <h3>{copy.rentT}</h3>
                <p>{copy.rentP}</p>
                <a class="link" href={href(lang, 'rent.html')}>{copy.rentCta}</a>
            </div>
            <div>
                <h3>{copy.gearT}</h3>
                <p>{copy.gearP}</p>
                <a class="link" href={href(lang, 'rent-gear.html')}>{copy.gearCta}</a>
            </div>
            <div>
                <h3>{copy.faqT}</h3>
                <p>{copy.faqP}</p>
                <a class="link" href={href(lang, 'faq.html')}>{copy.faqCta}</a>
            </div>
        </div>

        <div class="contact-details">
            <h3>{copy.detailsT}</h3>
            <p>
                <b>{business.name}</b><br>
                {business.locality}, {business.region}, {nl ? 'Nederland' : 'the Netherlands'}<br>
                <a href={`mailto:${business.email}`}>{business.email}</a> · <a href={`tel:${business.phone}`}>{business.phoneDisplay}</a><br>
                KVK {business.kvk}
            </p>
        </div>
    </section>
</Base>
