---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import HeroCarousel from './HeroCarousel.astro';
import InTheBack from './InTheBack.astro';
import BuildSheet from './BuildSheet.astro';
import TryRanger from './TryRanger.astro';
import GearBand from './GearBand.astro';
import { href, type Lang } from '../i18n';
import { business, links } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const nl = lang === 'nl';

const copy = {
    en: {
        title: 'JustRoam | Overland Truck Builds & Ranger Rental, Voorburg',
        description: 'We turn your pickup into an overland truck in three clear packages: canopy, power, kitchen, water and tents. Or rent our own Ford Ranger first. Voorburg, NL.',
        sheetKicker: 'Build sheet',
        sheetTitle: 'Three packages',
        sheetMore: 'Compare every detail',
        sheetCta: 'Plan your build',
        storiesKicker: 'Stories',
        storiesTitle: 'Built, then taken out',
        storiesMore: 'All stories',
        stories: [
            { t: 'Building a family-ready overland truck', d: 'Seven months, step by step', img: '/images/build/IMG_29.jpeg', w: 1960, h: 2614, page: 'blog_build.html' },
            { t: 'Maiden trip: Bosnia and Slovenia', d: 'Wild horses, and a dog who could not cross the border', img: '/images/rent/IMG_5025.jpeg', w: 1960, h: 1470, page: '' },
            { t: 'Autumn on Elba', d: 'Sun and island in the autumn break', img: '/images/rent/IMG_4254.jpeg', w: 1960, h: 1470, page: '' }
        ],
        soon: 'Coming soon',
        faqTitle: 'Questions about a build',
        faq: [
            { q: 'What is the difference between the packages?', a: "Getting started adds an aluminium canopy plus a dual-battery system with solar charging (± 1 month). Getting serious adds a custom interior, kitchen, fridge-ready installation and water system on top of that (± 2 months). Going all-in adds roof tent(s), a 270-degree awning, upgraded suspension and recovery equipment (± 3-4 months)." },
            { q: 'How long does a build take?', a: 'Roughly 1 month for Getting started, 2 months for Getting serious and 3-4 months for Going all-in. Build times also depend on parts availability.' },
            { q: 'Do I supply my own vehicle?', a: 'Yes. We convert a truck you own into an overland-ready vehicle, for vehicles in the Netherlands, Germany and Belgium.' }
        ]
    },
    nl: {
        title: 'JustRoam | Overland-ombouw en Ranger huren, Voorburg',
        description: 'Wij bouwen je pickup om tot overland-auto in drie duidelijke pakketten: opbouw, stroom, keuken, water en tenten. Of huur eerst onze eigen Ford Ranger. Voorburg.',
        sheetKicker: 'Bouwtabel',
        sheetTitle: 'Drie pakketten',
        sheetMore: 'Vergelijk alle details',
        sheetCta: 'Plan je ombouw',
        storiesKicker: 'Verhalen',
        storiesTitle: 'Gebouwd, en dan op pad',
        storiesMore: 'Alle verhalen',
        stories: [
            { t: 'Een overland-auto bouwen voor het hele gezin', d: 'Zeven maanden, stap voor stap', img: '/images/build/IMG_29.jpeg', w: 1960, h: 2614, page: 'blog_build.html' },
            { t: 'Eerste reis: Bosnië en Slovenië', d: 'Wilde paarden, en een hond die de grens niet over mocht', img: '/images/rent/IMG_5025.jpeg', w: 1960, h: 1470, page: '' },
            { t: 'Herfst op Elba', d: 'Zon en eiland in de herfstvakantie', img: '/images/rent/IMG_4254.jpeg', w: 1960, h: 1470, page: '' }
        ],
        soon: 'Binnenkort',
        faqTitle: 'Vragen over ombouw',
        faq: [
            { q: 'Wat is het verschil tussen de pakketten?', a: 'Getting started voegt een aluminium opbouw toe plus een tweede accu met zonnepaneel (± 1 maand). Getting serious voegt daar een interieur op maat, keuken, koelkastvoorbereiding en watersysteem aan toe (± 2 maanden). Going all-in voegt daktent(en), een 270-graden luifel, verbeterde vering en bergingsuitrusting toe (± 3-4 maanden).' },
            { q: 'Hoe lang duurt een ombouw?', a: 'Ongeveer 1 maand voor Getting started, 2 maanden voor Getting serious en 3-4 maanden voor Going all-in. De bouwtijd hangt ook af van de beschikbaarheid van onderdelen.' },
            { q: 'Lever ik mijn eigen auto aan?', a: 'Ja. We bouwen een auto die van jou is om tot overland-auto, voor voertuigen in Nederland, Duitsland en België.' }
        ]
    }
}[lang];

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: business.name,
        url: business.url + (nl ? '/nl/' : '/'),
        image: business.url + '/images/hero.jpg',
        telephone: business.phone,
        email: business.email,
        address: { '@type': 'PostalAddress', addressLocality: business.locality, addressRegion: business.region, addressCountry: business.country },
        priceRange: '€€',
        sameAs: [business.instagram, links.goboony],
        areaServed: ['Netherlands', 'Germany', 'Belgium'].map((name) => ({ '@type': 'Country', name }))
    },
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: copy.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
    }
];
---
<Base lang={lang} title={copy.title} description={copy.description} jsonLd={jsonLd}>
    <HeroCarousel lang={lang} />

    <section class="wrap section">
        <InTheBack lang={lang} />
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <div class="sheet-wrap topo">
            <div class="head-row">
                <div><span class="kicker">{copy.sheetKicker}</span><h2>{copy.sheetTitle}</h2></div>
                <a class="link" href={href(lang, 'build.html')}>{copy.sheetMore}</a>
            </div>
            <BuildSheet lang={lang} />
            <p style="margin:26px 0 0"><a class="btn" href={href(lang, 'contact.html')}>{copy.sheetCta} <span class="ar" aria-hidden="true">→</span></a></p>
        </div>
    </section>

    <section class="wrap" id="try" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <TryRanger lang={lang} />
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <GearBand lang={lang} />
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <div class="head-row">
            <div><span class="kicker">{copy.storiesKicker}</span><h2>{copy.storiesTitle}</h2></div>
            <a class="link" href={href(lang, 'stories.html')}>{copy.storiesMore}</a>
        </div>
        <div class="cards3">
            {copy.stories.map((s) => {
                const inner = (
                    <>
                        <div class="frame"><Photo class="cover" src={s.img} width={s.w} height={s.h} alt={s.t} sizes="(max-width: 860px) 100vw, 33vw" /></div>
                        <b>{s.t}</b><span>{s.d}</span>
                        {!s.page && <><br><span class="soon">{copy.soon}</span></>}
                    </>
                );
                return s.page ? <a class="scard" href={href(lang, s.page)}>{inner}</a> : <div class="scard">{inner}</div>;
            })}
        </div>
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <h2 style="margin-bottom:22px">{copy.faqTitle}</h2>
        <div class="faq">
            {copy.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
    </section>
</Base>
