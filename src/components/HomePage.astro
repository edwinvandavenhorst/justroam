---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import HeroCarousel from './HeroCarousel.astro';
import InTheBack from './InTheBack.astro';
import TryRanger from './TryRanger.astro';
import GearBand from './GearBand.astro';
import { href, type Lang } from '../i18n';
import { business, links, packages, euro, daysText } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const nl = lang === 'nl';

const copy = {
    en: {
        title: 'JustRoam | Pickup Truck & 4x4 Overland Builds, Ranger Rental Voorburg',
        description: 'We turn your pickup truck or 4x4 into an overland vehicle: two packages and two add-ons, from power to kitchen, water and off-road. Or rent our own Ford Ranger first. Voorburg, NL.',
        sheetKicker: 'Build packages',
        sheetTitle: 'Two packages, two add-ons',
        sheetMore: 'See what is in each package',
        sheetCta: 'Plan your build',
        storiesKicker: 'Stories',
        storiesTitle: 'Built, then taken out',
        storiesMore: 'All stories',
        stories: [
            { t: 'Building a family-ready overland pickup', d: 'Seven months, step by step', img: '/images/build/IMG_29.jpeg', w: 1960, h: 2614, page: 'blog_build.html' },
            { t: 'Maiden trip: Bosnia and Slovenia', d: 'Wild horses, and a dog who could not cross the border', img: '/images/rent/IMG_5025.jpeg', w: 1960, h: 1470, page: '' },
            { t: 'Autumn on Elba', d: 'Sun and island in the autumn break', img: '/images/rent/IMG_4254.jpeg', w: 1960, h: 1470, page: '' }
        ],
        soon: 'Coming soon',
        faqTitle: 'Questions about a build',
        faq: [
            { q: 'What is the difference between the packages?', a: 'Basis gives you power on the road: a second battery, LED lighting, USB and 12V and a battery monitor. Ready to camp adds an interior made for your vehicle, a kitchen, a fridge and water. On top of either you can add Full off-road and outdoor lighting.' },
            { q: 'How long does a build take?', a: 'We count in workshop days: about 5 for Basis and about 15 for Ready to camp, plus about 4 for off-road and 1 for lighting. We agree the dates together in the intake.' },
            { q: 'Do I supply my own vehicle?', a: 'Yes. We convert a pickup or 4x4 you own into an overland-ready vehicle, for vehicles in the Netherlands, Germany and Belgium.' }
        ]
    },
    nl: {
        title: 'JustRoam | Overland-ombouw en Ranger huren, Voorburg',
        description: 'Wij bouwen je pickup of 4x4 om tot overland-auto: twee pakketten en twee add-ons, van stroom tot keuken, water en off-road. Of huur eerst onze eigen Ford Ranger. Voorburg.',
        sheetKicker: 'Ombouwpakketten',
        sheetTitle: 'Twee pakketten, twee add-ons',
        sheetMore: 'Bekijk wat er in elk pakket zit',
        sheetCta: 'Plan je ombouw',
        storiesKicker: 'Verhalen',
        storiesTitle: 'Gebouwd, en dan op pad',
        storiesMore: 'Alle verhalen',
        stories: [
            { t: 'Een overland-auto bouwen voor het hele gezin', d: 'Zeven maanden, stap voor stap', img: '/images/build/IMG_29.jpeg', w: 1960, h: 2614, page: 'blog_build.html' },
            { t: 'Eerste reis: Bosnië en Slovenië', d: 'Wilde paarden, en een hond die de grens niet over mocht', img: '/images/rent/IMG_5025.jpeg', w: 1960, h: 1470, page: '' },
            { t: 'Herfst op Elba', d: 'Zon en eiland in de herfstvakantie', img: '/images/rent/IMG_4254.jpeg', w: 1960, h: 1470, page: '' }
        ],
        soon: 'Binnenkort',
        faqTitle: 'Vragen over ombouw',
        faq: [
            { q: 'Wat is het verschil tussen de pakketten?', a: 'Basis geeft je stroom onderweg: een tweede accu, LED-verlichting, USB en 12V en een accumonitor. Ready to camp voegt een interieur op maat, keuken, koelkast en water toe. Daarbovenop kun je Full off-road en buitenverlichting toevoegen.' },
            { q: 'Hoe lang duurt een ombouw?', a: 'We rekenen in werkdagen: ongeveer 5 voor Basis en ongeveer 15 voor Ready to camp, plus ongeveer 4 voor off-road en 1 voor verlichting. De data spreken we samen af in de intake.' },
            { q: 'Lever ik mijn eigen auto aan?', a: 'Ja. We bouwen een auto die van jou is om tot overland-auto, voor voertuigen in Nederland, Duitsland en België.' }
        ]
    }
}[lang];

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: business.name,
        url: business.url + (nl ? '/nl/' : '/'),
        image: business.url + '/images/hero.jpg',
        telephone: business.phone,
        email: business.email,
        address: { '@type': 'PostalAddress', addressLocality: business.locality, addressRegion: business.region, addressCountry: business.country },
        priceRange: '€€',
        sameAs: [business.instagram, links.goboony],
        areaServed: ['Netherlands', 'Germany', 'Belgium'].map((name) => ({ '@type': 'Country', name }))
    },
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: copy.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
    }
];
---
<Base lang={lang} title={copy.title} description={copy.description} jsonLd={jsonLd}>
    <HeroCarousel lang={lang} />

    <section class="wrap section">
        <InTheBack lang={lang} />
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <div class="sheet-wrap topo">
            <div class="head-row">
                <div><span class="kicker">{copy.sheetKicker}</span><h2>{copy.sheetTitle}</h2></div>
                <a class="link" href={href(lang, 'build.html')}>{copy.sheetMore}</a>
            </div>
            <div class="pk-tiles">
                {packages.map((p) => <a class={p.addon ? 'addon' : ''} href={href(lang, 'build.html#pk-' + p.key)}><b>{p.name[lang]}</b><strong>{nl ? 'Vanaf' : 'From'} {euro(p.from, lang)}</strong>{daysText(p, lang)}</a>)}
            </div>
            <p style="margin:26px 0 0"><a class="btn" href={href(lang, 'contact.html')}>{copy.sheetCta} <span class="ar" aria-hidden="true">→</span></a></p>
        </div>
    </section>

    <section class="wrap" id="try" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <TryRanger lang={lang} />
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <GearBand lang={lang} />
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <div class="head-row">
            <div><span class="kicker">{copy.storiesKicker}</span><h2>{copy.storiesTitle}</h2></div>
            <a class="link" href={href(lang, 'stories.html')}>{copy.storiesMore}</a>
        </div>
        <div class="cards3">
            {copy.stories.map((s) => {
                const inner = (
                    <>
                        <div class="frame"><Photo class="cover" src={s.img} width={s.w} height={s.h} alt={s.t} sizes="(max-width: 860px) 100vw, 33vw" /></div>
                        <b>{s.t}</b><span>{s.d}</span>
                        {!s.page && <><br><span class="soon">{copy.soon}</span></>}
                    </>
                );
                return s.page ? <a class="scard" href={href(lang, s.page)}>{inner}</a> : <div class="scard">{inner}</div>;
            })}
        </div>
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <h2 style="margin-bottom:22px">{copy.faqTitle}</h2>
        <div class="faq">
            {copy.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
    </section>
</Base>
