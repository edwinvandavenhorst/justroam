---
<Base lang={lang} title={copy.title} description={copy.description} ogImage="/images/rent/IMG_4042.jpeg" jsonLd={jsonLd}>
    <div class="wrap">
        <div class="intro">
            <span class="kicker">{copy.kicker}</span>
            <h1>{copy.h1}</h1>
        </div>
        <div class="rg">
            <div class="rg-main">
                <div class="rg-track">
                    {photos.map((m, i) => <button type="button" class:list={['rg-slide', { contain: m.fit === 'contain' }]} style={m.pos ? `--pos:${m.pos}` : undefined} data-gal-open={i} aria-label={`${copy.galOpen}: ${m[lang]}`}><Photo src={m.src} width={m.w} height={m.h} alt={m[lang]} sizes="(max-width: 960px) 100vw, 1240px" eager={i < 2} /></button>)}
                </div>
                <button type="button" class="gal-btn rg-prev" aria-label={copy.galPrev}>‹</button>
                <button type="button" class="gal-btn rg-next" aria-label={copy.galNext}>›</button>
                <p class="rg-count"><span>1</span> / {photos.length}</p>
            </div>
            <div class="rg-thumbs">
                {photos.map((m, i) => <button type="button" class:list={['rg-thumb', { on: i === 0 }]} data-rg-go={i} aria-label={m[lang]}><Photo src={m.src} width={m.w} height={m.h} alt="" sizes="160px" /></button>)}
            </div>
        </div>
        <dialog class="gal" aria-label={copy.galLabel}>
            <div class="gal-track">
                {photos.map((m) => <figure class="gal-slide"><Photo src={m.src} width={m.w} height={m.h} alt={m[lang]} sizes="100vw" /><figcaption>{m[lang]}</figcaption></figure>)}
            </div>
            <button type="button" class="gal-btn gal-prev" aria-label={copy.galPrev}>‹</button>
            <button type="button" class="gal-btn gal-next" aria-label={copy.galNext}>›</button>
            <button type="button" class="gal-close" aria-label={copy.galClose}>×</button>
            <p class="gal-count"><span>1</span> / {photos.length}</p>
        </dialog>

        <div class="listing">
            <div>
                <p class="spec"><b>{copy.spec}</b></p>
                <div class="host"><span class="avatar">E</span><div><b>{copy.hostT}</b><br><span>{copy.hostD}</span></div></div>
                <div class="rent-reviews">
                    <h3>{copy.reviewsT}</h3>
                    <div class="reviews">
                        {copy.reviews.map(([q, who, when]) => <figure><blockquote>“{q}”</blockquote><figcaption><b>{who}</b> · {when}</figcaption></figure>)}
                    </div>
                    <p class="reviews-note">{copy.reviewsNote} <a class="link" href={links.goboony + '#reviews'} target="_blank" rel="noopener">{copy.reviewsLink}</a></p>
                </div>
                <ul class="highlights">
                    {copy.highlights.map(([ic, t, d]) => (
                        <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[ic]} /></svg><div><b>{t}</b><span>{d}</span></div></li>
                    ))}
                </ul>
                <div class="block">
                    <h2>{copy.onboardT}</h2>
                    <ul class="amenities">
                        {copy.onboard.map(([ic, t]) => <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[ic]} /></svg><span>{t}</span></li>)}
                    </ul>
                </div>
                <div class="block" id="availability">
                    <h2>{copy.availT}</h2>
                    <RangerCalendar lang={lang} />
                    <p style="color:var(--muted);font-size:14px;margin-top:12px">{copy.availNote}</p>
                </div>
                <div class="block">
                    <h2>{copy.knowT}</h2>
                    <div class="know">{copy.know.map(([t, d]) => <div><b>{t}</b>{d}</div>)}</div>
                </div>

            </div>

            <aside>
                <div class="book">
                    <div class="price">€{r.fromPerDay} <small>{copy.priceFrom}</small></div>
                    <div class="rows">{copy.rows.map(([a, b]) => <div class="row"><span>{a}</span><b>{b}</b></div>)}</div>
                    <a class="btn" href={links.goboony} target="_blank" rel="noopener">{copy.book} <span class="ar" aria-hidden="true">→</span></a>
                    <span class="note">{copy.bookNote}</span>
                    <a class="link second" href="#availability">{copy.checkDates}</a>
                </div>
            </aside>
        </div>
    </div>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <InTheBack lang={lang} title={copy.backTitle} photoRight ctaLabel={lang === 'nl' ? 'Ook zo? Start je ombouw' : 'Want this? Start your build'} />
    </section>

    <section class="build-band">
        <div class="wrap">
            <div>
                <h2>{copy.bandT}</h2>
                <p>{copy.bandP}</p>
                <a class="btn sand" href={href(lang, 'contact.html')}>{copy.bandCta} <span class="ar" aria-hidden="true">→</span></a>
            </div>
            <div class="pk-links">
                {packages.map((p, i) => <a href={href(lang, 'build.html#pk-' + p.key)}><b>{p.name[lang]}</b><span>{copy.pkDesc[i]} · {copy.from} {euro(p.from, lang)}</span></a>)}
            </div>
        </div>
    </section>

    <section class="wrap section">
        <h2 style="margin-bottom:22px">{copy.faqT}</h2>
        <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </section>

    <section class="wrap" style="padding-bottom: clamp(56px, 8vw, 90px)">
        <GearBand lang={lang} />
    </section>
</Base>

<script>
    // Photo carousel on the page (arrows, swipe, thumbnails) and the same
    // photos full screen in a dialog, opened at the photo that was clicked.
    function carousel(track: HTMLElement, onChange?: (i: number) => void, wrap = true) {
        const total = track.children.length;
        const current = () => Math.round(track.scrollLeft / track.clientWidth);
        const go = (i: number, smooth = true) => {
            const n = wrap ? (i + total) % total : Math.min(Math.max(i, 0), total - 1);
            track.scrollTo({ left: n * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
        };
        let last = -1;
        const check = () => {
            const i = current();
            if (i !== last) { last = i; onChange?.(i); }
        };
        track.addEventListener('scroll', check, { passive: true });
        check();
        return { go, current, total };
    }

    // On the page, as on the old site: no wrapping round, the arrow at the
    // first or last photo disappears, the arrow keys work anywhere on the
    // page, and a thumbnail jumps straight to its photo.
    const rgTrack = document.querySelector<HTMLElement>('.rg-track');
    const thumbs = [...document.querySelectorAll<HTMLElement>('.rg-thumb')];
    const rgCount = document.querySelector('.rg-count span');
    const rgPrev = document.querySelector<HTMLElement>('.rg-prev');
    const rgNext = document.querySelector<HTMLElement>('.rg-next');
    if (rgTrack) {
        const rg = carousel(rgTrack, (i) => {
            if (rgCount) rgCount.textContent = String(i + 1);
            thumbs.forEach((t, k) => t.classList.toggle('on', k === i));
            if (rgPrev) rgPrev.hidden = i === 0;
            if (rgNext) rgNext.hidden = i === thumbs.length - 1;
        }, false);
        rgPrev?.addEventListener('click', () => rg.go(rg.current() - 1));
        rgNext?.addEventListener('click', () => rg.go(rg.current() + 1));
        thumbs.forEach((t) => t.addEventListener('click', () => {
            rg.go(Number(t.dataset.rgGo), false);
            rgTrack.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }));
        document.addEventListener('keydown', (e) => {
            if (document.querySelector('dialog.gal[open]')) return;
            const el = e.target as HTMLElement;
            if (el.closest('input, textarea, select, [contenteditable]')) return;
            if (e.key === 'ArrowLeft' && rg.current() > 0) rg.go(rg.current() - 1);
            if (e.key === 'ArrowRight' && rg.current() < rg.total - 1) rg.go(rg.current() + 1);
        });
    }

    const dlg = document.querySelector<HTMLDialogElement>('dialog.gal');
    const galTrack = dlg?.querySelector<HTMLElement>('.gal-track');
    const galCount = dlg?.querySelector('.gal-count span');
    if (dlg && galTrack) {
        const gal = carousel(galTrack, (i) => { if (galCount) galCount.textContent = String(i + 1); });
        document.querySelectorAll<HTMLElement>('[data-gal-open]').forEach((b) =>
            b.addEventListener('click', () => {
                dlg.showModal();
                gal.go(Number(b.dataset.galOpen), false);
            })
        );
        dlg.querySelector('.gal-prev')?.addEventListener('click', () => gal.go(gal.current() - 1));
        dlg.querySelector('.gal-next')?.addEventListener('click', () => gal.go(gal.current() + 1));
        dlg.querySelector('.gal-close')?.addEventListener('click', () => dlg.close());
        dlg.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') gal.go(gal.current() - 1);
            if (e.key === 'ArrowRight') gal.go(gal.current() + 1);
        });
    }
</script>
